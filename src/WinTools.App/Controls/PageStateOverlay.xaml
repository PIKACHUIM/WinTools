<UserControl x:Class="WinTools.App.Controls.PageStateOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:WinTools.App.Controls">

    <!-- DataContext 是页签视图模型（SectionViewModelBase）。五种状态互斥显示。 -->
    <Grid>

        <!-- 加载中：骨架屏 + 当前阶段说明 -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <ctl:SkeletonList VerticalAlignment="Top" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,16">
                <ctl:Spinner VerticalAlignment="Center" />
                <TextBlock Text="{Binding LoadingText}" Style="{StaticResource CaptionText}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 空 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmptyState, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34"
                       HorizontalAlignment="Center" Foreground="{DynamicResource App.Text.Tertiary}" />
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource App.Text.Tertiary}" />
        </StackPanel>

        <!-- 无匹配（有数据但被搜索过滤光） -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30"
                       HorizontalAlignment="Center" Foreground="{DynamicResource App.Text.Tertiary}" />
            <TextBlock Text="{Binding NoMatchText}" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource App.Text.Tertiary}" />
        </StackPanel>

        <!-- 失败 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                    Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="&#xEA39;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="34"
                       HorizontalAlignment="Center" Foreground="{DynamicResource App.Danger}" />
            <TextBlock Text="{Binding LoadFailedText}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                       Margin="0,10,0,0" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
            <Button Content="{Binding RetryLabel}" Style="{StaticResource PrimaryButton}" Padding="20,7"
                    Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- 待开始（需要用户主动触发，例如「搜索更新」） -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
            <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                    Background="{DynamicResource App.Selection}">
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Accent}" />
            </Border>
            <TextBlock Text="{Binding IdleText}" Style="{StaticResource BodyText}" Margin="0,14,0,0"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                       Visibility="{Binding IdleText, Converter={StaticResource StringToVisibility}}" />
            <Button Content="{Binding IdleActionLabel}" Style="{StaticResource PrimaryButton}" Padding="24,9"
                    Margin="0,16,0,0" HorizontalAlignment="Center" Command="{Binding IdleActionCommand}"
                    Visibility="{Binding IdleActionLabel, Converter={StaticResource StringToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
