<UserControl x:Class="WinTools.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
        <StackPanel>

            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />

            <!-- 外观 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding AppearanceLabel}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                    <TextBlock Text="{Binding ThemeLabel}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding ThemeOptions}"
                             SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource PillItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" FontSize="13" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource CaptionText}" Margin="0,14,0,8" />
                    <ListBox ItemsSource="{Binding Languages}"
                             SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource PillItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding LanguageHint}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- 行为 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding BehaviorLabel}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                    <CheckBox Content="{Binding RecycleBinLabel}" Style="{StaticResource AppCheckBox}"
                              IsChecked="{Binding UseRecycleBin, Mode=TwoWay}" Margin="0,0,0,14" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ConcurrencyLabel}" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding ConcurrencyOptions}"
                                  SelectedItem="{Binding ScanConcurrency, Mode=TwoWay}"
                                  Width="90" Height="30" Margin="12,0,0,0"
                                  VerticalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 数据与日志 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding StorageLabel}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DataDirLabel}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding DataDirectory}" Style="{StaticResource ValueText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{Binding OpenFolderLabel}" Style="{StaticResource SubtleButton}"
                                Command="{Binding OpenDataDirectoryCommand}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LogDirLabel}" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding LogDirectory}" Style="{StaticResource ValueText}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{Binding OpenFolderLabel}" Style="{StaticResource SubtleButton}"
                                Command="{Binding OpenLogDirectoryCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding AboutLabel}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WinTools" Style="{StaticResource ValueText}" FontWeight="SemiBold" />
                        <TextBlock Text="·" Margin="8,0" Foreground="{DynamicResource App.Text.Tertiary}" />
                        <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource BodyText}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
