<UserControl x:Class="WinTools.App.Views.Sections.BackupTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="CaretBrush" Value="{DynamicResource App.Text.Primary}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Style="{StaticResource Card}" Padding="20" VerticalAlignment="Top">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding TitleText}" Style="{StaticResource SectionTitle}" />

            <!-- 表单 -->
            <Grid Grid.Row="1" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 源目录 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12"
                            Visibility="{Binding ShowSource, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 映像路径 -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12">
                    <TextBlock Text="{Binding ImageLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 映像名称 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12"
                            Visibility="{Binding ShowImageSettings, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding NameLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding ImageName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 描述 -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,12"
                            Visibility="{Binding ShowImageSettings, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding DescriptionLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 释放目标目录 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12"
                            Visibility="{Binding ShowApplySettings, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!-- 索引 + 校验 -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,12" Orientation="Horizontal"
                            Visibility="{Binding ShowApplySettings, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Width="120">
                        <TextBlock Text="{Binding IndexLabel}" Style="{StaticResource FieldLabel}" />
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding ImageIndex, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource AppCheckBox}" Content="{Binding VerifyLabel}"
                              IsChecked="{Binding Verify}" Margin="18,24,0,0" VerticalAlignment="Top" />
                </StackPanel>

                <!-- 压缩级别 -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,4"
                            Visibility="{Binding ShowImageSettings, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding CompressionLabel}" Style="{StaticResource FieldLabel}" />
                    <ListBox ItemsSource="{Binding CompressionOptions}"
                             SelectedIndex="{Binding CompressionIndex, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource PillItem}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </Grid>

            <!-- 操作与进度 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{Binding StartLabel}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}" Padding="18,8" />
                <ProgressBar Style="{StaticResource AppProgress}" Width="220" Height="4" Margin="16,0,0,0"
                             VerticalAlignment="Center" Maximum="100" Value="{Binding ProgressPercent}"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="14,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- 日志 -->
            <Border Grid.Row="3" Style="{StaticResource SoftCard}" Margin="0,14,0,0" Padding="12"
                    Visibility="{Binding Log, Converter={StaticResource StringToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding LogLabel}" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding Log}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.Text.Secondary}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
    </ScrollViewer>
</UserControl>
