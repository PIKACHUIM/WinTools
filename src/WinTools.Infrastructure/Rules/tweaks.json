[
  {
    "id": "telemetry-off",
    "recommended": true,
    "group": "Privacy",
    "name": { "zh-Hans": "关闭诊断遥测", "en-US": "Disable diagnostic telemetry" },
    "description": { "zh-Hans": "遥测级别设为「安全」，并禁用 DiagTrack 服务，减少后台数据上传。", "en-US": "Set telemetry to Security level and disable the DiagTrack service." },
    "risk": "Low",
    "requiresRestart": false,
    "detect": [ { "type": "RegSet", "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "kind": "DWord", "value": "0" } ],
    "apply": [ { "type": "RegSet", "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "kind": "DWord", "value": "0" } ],
    "revert": [ { "type": "RegDeleteValue", "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry" } ]
  },
  {
