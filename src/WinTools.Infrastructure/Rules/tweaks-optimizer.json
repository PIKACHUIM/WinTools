    {
        "id":  "op-network-throttling",
        "group":  "Network",
        "recommended":  true,
        "name":  {
                     "zh-Hans":  "关闭网络限速",
                     "en-US":  "Disable network throttling"
                 },
        "description":  {
                            "zh-Hans":  "关闭系统对多媒体网络的限速，改善串流与游戏延迟。",
                            "en-US":  "Removes Windows network throttling used for multimedia streaming."
                        },
        "risk":  "Low",
        "detect":  [
                       {
                           "type":  "RegSet",
                           "hive":  "HKLM",
                           "path":  "SOFTWARE\\Policies\\Microsoft\\Windows\\Psched",
                           "name":  "NonBestEffortLimit",
                           "kind":  "DWord",
                           "value":  "0"
                       }
                   ],
        "apply":  [
                      {
                          "type":  "RegSet",
                          "hive":  "HKLM",
                          "path":  "SOFTWARE\\Policies\\Microsoft\\Windows\\Psched",
                          "name":  "NonBestEffortLimit",
                          "kind":  "DWord",
                          "value":  "0"
                      }
                  ],
        "revert":  [
                       {
                           "type":  "RegSet",
