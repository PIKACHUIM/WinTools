[
  {
    "id": "sync-settings-off",
    "group": "Privacy",
    "recommended": true,
    "name": { "zh-Hans": "关闭设置同步", "en-US": "Disable settings sync" },
    "description": { "zh-Hans": "不同步主题、密码与语言偏好到微软账户。", "en-US": "Stop syncing theme, passwords and language preferences." },
    "risk": "Low",
    "detect": [ { "type": "RegSet", "hive": "HKCU", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\SettingSync", "name": "DisableSettingSync", "kind": "DWord", "value": "2" } ],
    "apply": [ { "type": "RegSet", "hive": "HKCU", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\SettingSync", "name": "DisableSettingSync", "kind": "DWord", "value": "2" }, { "type": "RegSet", "hive": "HKCU", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\SettingSync", "name": "DisableSettingSyncUserOverride", "kind": "DWord", "value": "1" } ],
    "revert": [ { "type": "RegDeleteValue", "hive": "HKCU", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\SettingSync", "name": "DisableSettingSync" }, { "type": "RegDeleteValue", "hive": "HKCU", "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\SettingSync", "name": "DisableSettingSyncUserOverride" } ]
  },
