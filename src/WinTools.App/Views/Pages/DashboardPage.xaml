<UserControl x:Class="WinTools.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WinTools.App.ViewModels"
             d:DesignHeight="900" d:DesignWidth="1000"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="MetricValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        </Style>

        <Style x:Key="MetricSubText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 硬件行的标签列 -->
        <Style x:Key="InfoLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,3,16,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="InfoPrimary" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="InfoSecondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- 多值硬件：每条一行，左侧小圆点 -->
        <DataTemplate DataType="{x:Type vm:HardwareLine}">
            <Grid Margin="0,2,0,2">
                <Border Width="4" Height="4" CornerRadius="2" VerticalAlignment="Top"
                        Margin="2,8,0,0" HorizontalAlignment="Left"
                        Background="{DynamicResource App.Text.Tertiary}" />
                <StackPanel Margin="16,0,0,0">
                    <TextBlock Text="{Binding Primary}" Style="{StaticResource InfoPrimary}" />
                    <TextBlock Text="{Binding Secondary}" Style="{StaticResource InfoSecondary}"
                               Visibility="{Binding Secondary, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 分区：固定宽度轨道 + 比例填充（不用 ProgressBar，避免 ItemsControl 里的测量死循环） -->
        <DataTemplate DataType="{x:Type vm:VolumeRow}">
            <StackPanel Margin="0,3,0,7">
                <Grid Width="360" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" FontSize="12" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Label, Mode=OneWay}" />
                        <Run Text="   " />
                        <Run Text="{Binding SizeText, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" Margin="10,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource App.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Width="300" Height="5" CornerRadius="3" Margin="0,6,0,0" HorizontalAlignment="Left"
                        Background="{DynamicResource App.Track}" ClipToBounds="True">
                    <Border HorizontalAlignment="Left" CornerRadius="3" Width="{Binding BarWidth}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource App.Accent}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource App.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 网卡：名称 + 状态点 + 速率/IP + MAC，各占一行 -->
        <DataTemplate DataType="{x:Type vm:NetworkLine}">
            <StackPanel Margin="0,3,0,5">
                <StackPanel Orientation="Horizontal">
                    <Border Width="7" Height="7" CornerRadius="3.5" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource App.BorderStrong}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource App.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- 水平排列里不能带 TextWrapping=Wrap：无限宽度 + 换行会触发测量死循环 -->
                    <TextBlock Text="{Binding Name}" Style="{StaticResource InfoPrimary}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding Detail}" Style="{StaticResource InfoSecondary}" Margin="15,1,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource StringToVisibility}}" />
                <TextBlock Text="{Binding Mac}" Style="{StaticResource InfoSecondary}" Margin="15,0,0,0"
                           FontSize="11" Foreground="{DynamicResource App.Text.Tertiary}"
                           Visibility="{Binding Mac, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- 右侧多留 14px：垂直滚动条出现时会占掉视口宽度，否则第 5 张卡片会被压住 -->
        <StackPanel Margin="28,20,42,28">

            <!-- 标题 -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,5,0,0">
                        <Run Text="{Binding Profile.ComputerName, Mode=OneWay, FallbackValue='—'}" />
                        <Run Text="  ·  " />
                        <Run Text="{Binding Profile.OsName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Button Content="{Binding RefreshLabel}" Style="{StaticResource GhostButton}"
                        Command="{Binding RefreshCommand}" Padding="14,7"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <!-- 实时占用 -->
            <UniformGrid Columns="5" Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="15,13">
                    <StackPanel>
                        <TextBlock Text="{Binding CpuLabel}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding CpuPercent, Converter={StaticResource PercentText}}"
                                   Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                        <ProgressBar Style="{StaticResource AppProgress}" Value="{Binding CpuPercent}"
                                     Maximum="100" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding CpuSummary}" Style="{StaticResource MetricSubText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="15,13">
                    <StackPanel>
                        <TextBlock Text="{Binding MemoryLabel}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding MemoryPercent, Converter={StaticResource PercentText}}"
                                   Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                        <ProgressBar Style="{StaticResource AppProgress}" Value="{Binding MemoryPercent}"
                                     Maximum="100" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding MemoryText}" Style="{StaticResource MetricSubText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="15,13">
                    <StackPanel>
                        <TextBlock Text="{Binding DiskLabel}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding DiskUsagePercent, Converter={StaticResource PercentText}}"
                                   Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                        <ProgressBar Style="{StaticResource AppProgress}" Value="{Binding DiskUsagePercent}"
                                     Maximum="100" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding DiskSummary}" Style="{StaticResource MetricSubText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="15,13">
                    <StackPanel>
                        <TextBlock Text="{Binding NetworkSection}" Style="{StaticResource CaptionText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="↓" FontSize="13" Foreground="{DynamicResource App.Accent}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding NetDown, Converter={StaticResource BytesPerSecond}}"
                                       Style="{StaticResource MetricValueText}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="↑" FontSize="13" Foreground="{DynamicResource App.Success}"
                                       VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding NetUp, Converter={StaticResource BytesPerSecond}}"
                                       Style="{StaticResource MetricValueText}" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="{Binding NetSummary}" Style="{StaticResource MetricSubText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="15,13">
                    <StackPanel>
                        <TextBlock Text="{Binding GpuLabel}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding GpuPercent, Converter={StaticResource PercentText}}"
                                   Style="{StaticResource MetricValueText}" Margin="0,4,0,0" />
                        <ProgressBar Style="{StaticResource AppProgress}" Value="{Binding GpuPercent}"
                                     Maximum="100" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding GpuSummary}" Style="{StaticResource MetricSubText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 硬件信息 -->
            <TextBlock Text="{Binding HardwareSection}" Style="{StaticResource SectionTitle}" Margin="2,22,0,10" />

            <Border Style="{StaticResource Card}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 系统 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SystemLabel}" Style="{StaticResource InfoLabel}" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="{Binding OsText}" Style="{StaticResource InfoPrimary}" />
                        <TextBlock Text="{Binding OsDetailText}" Style="{StaticResource InfoSecondary}" />
                    </StackPanel>

                    <!-- 主板 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding BoardLabel}" Style="{StaticResource InfoLabel}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BoardText}"
                               Style="{StaticResource InfoPrimary}" Margin="0,0,0,14" />

                    <!-- 处理器 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding CpuLabel}" Style="{StaticResource InfoLabel}" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource InfoPrimary}" />
                        <TextBlock Text="{Binding CpuDetailText}" Style="{StaticResource InfoSecondary}" />
                    </StackPanel>

                    <!-- 显卡 -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding GraphicsLabel}" Style="{StaticResource InfoLabel}" />
                    <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Graphics}" Margin="0,0,0,14" />

                    <!-- 内存 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding MemoryModuleLabel}" Style="{StaticResource InfoLabel}" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Text="{Binding MemorySummary}" Style="{StaticResource InfoPrimary}" Margin="0,0,0,2" />
                        <ItemsControl ItemsSource="{Binding MemoryModules}" />
                    </StackPanel>

                    <!-- 硬盘 -->
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding DiskLabel2}" Style="{StaticResource InfoLabel}" />
                    <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Disks}" Margin="0,0,0,14" />

                    <!-- 分区（带进度条） -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding VolumeLabel}" Style="{StaticResource InfoLabel}" />
                    <ItemsControl Grid.Row="6" Grid.Column="1" ItemsSource="{Binding Volumes}" Margin="0,0,0,14" />

                    <!-- 声卡 -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding SoundLabel}" Style="{StaticResource InfoLabel}" />
                    <ItemsControl Grid.Row="7" Grid.Column="1" ItemsSource="{Binding SoundDevices}" Margin="0,0,0,14" />

                    <!-- 网络 -->
                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding NetworkSection}" Style="{StaticResource InfoLabel}" />
                    <ItemsControl Grid.Row="8" Grid.Column="1" ItemsSource="{Binding Networks}" Margin="0,0,0,14" />

                    <!-- 系统版本 -->
                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding VersionLabel}" Style="{StaticResource InfoLabel}" />
                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Profile.OsBuild}"
                               Style="{StaticResource InfoPrimary}" />
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
