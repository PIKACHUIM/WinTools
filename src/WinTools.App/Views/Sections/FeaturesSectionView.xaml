<UserControl x:Class="WinTools.App.Views.Sections.FeaturesSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource Card}" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,4">
                            <!-- 用途分类头 -->
                            <Grid Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Width="22" Height="22" Padding="0"
                                        Style="{StaticResource SubtleButton}" VerticalAlignment="Center"
                                        Command="{Binding DataContext.ToggleGroupCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Path Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource App.Text.Secondary}"
                                          StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" CenterX="2" CenterY="4" />
                                        </Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" CenterX="2" CenterY="4" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>

                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.Text.Primary}" />

                                <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />

                                <Button Grid.Column="3"
                                        Content="{Binding DataContext.ToggleAllText,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Style="{StaticResource SubtleButton}" FontSize="11.5" Padding="10,2"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.ToggleGroupAllCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>

                            <!-- 功能族与子功能 -->
                            <ItemsControl ItemsSource="{Binding Families}"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="18,0,0,2">
                                            <!-- 父行（单条目族不显示） -->
                                            <Grid Height="34"
                                                  Visibility="{Binding ShowHeader, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Width="18" Height="18" Padding="0"
                                                        Style="{StaticResource SubtleButton}" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.ToggleFamilyExpandCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE76C;" FontSize="9"
                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               Foreground="{DynamicResource App.Text.Secondary}" />
                                                </Button>

                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                                                           FontWeight="SemiBold" Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource App.Text.Primary}" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" />
                                                    <TextBlock Text="{Binding DataContext.MixedLabel,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource CaptionText}"
                                                               Margin="8,0,0,0"
                                                               Foreground="{DynamicResource App.Warning}"
                                                               Visibility="{Binding IsMixed,
                                                                            Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>

                                                <CheckBox Grid.Column="4" Style="{StaticResource AppSwitch}"
                                                          VerticalAlignment="Center" Margin="10,0,4,0"
                                                          IsChecked="{Binding AllOn, Mode=OneWay}"
                                                          IsThreeState="False"
                                                          Command="{Binding DataContext.ToggleFamilyCommand,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                            </Grid>

                                            <!-- 子项 -->
                                            <ItemsControl ItemsSource="{Binding Items}"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="34" Margin="22,0,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                                        Visibility="{Binding IsVisible,
                                                                                     Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="{Binding Display}" FontSize="12.5"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource App.Text.Primary}" />
                                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource App.Text.Tertiary}"
                                                                           Visibility="{Binding HasDescription,
                                                                                        Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>

                                                            <CheckBox Grid.Column="1" Style="{StaticResource AppSwitch}"
                                                                      VerticalAlignment="Center" Margin="10,0,4,0"
                                                                      IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                                      IsEnabled="{Binding IsEditable}"
                                                                      Visibility="{Binding IsVisible,
                                                                                   Converter={StaticResource BoolToVisibility}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
