<UserControl x:Class="WinTools.App.Controls.SkeletonList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <!-- 每行第一根灰条的右侧留白，让各行长短不一，更像真实内容 -->
        <x:Array x:Key="Insets" Type="{x:Type Thickness}">
            <Thickness>0,0,70,0</Thickness>
            <Thickness>0,0,150,0</Thickness>
            <Thickness>0,0,40,0</Thickness>
            <Thickness>0,0,190,0</Thickness>
            <Thickness>0,0,100,0</Thickness>
            <Thickness>0,0,60,0</Thickness>
            <Thickness>0,0,170,0</Thickness>
            <Thickness>0,0,90,0</Thickness>
        </x:Array>

        <Style x:Key="SkeletonBar" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource App.Track}" />
        </Style>
    </UserControl.Resources>

    <!-- 呼吸闪烁：只在可见时运行 -->
    <ItemsControl ItemsSource="{StaticResource Insets}">
        <ItemsControl.Style>
            <Style TargetType="ItemsControl">
                <Style.Triggers>
                    <Trigger Property="IsVisible" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard x:Name="Pulse">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="1"
                                                     Duration="0:0:0.85" AutoReverse="True" RepeatBehavior="Forever">
                                        <DoubleAnimation.EasingFunction>
                                            <SineEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="Pulse" />
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ItemsControl.Style>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="10,7" Height="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="32" Height="32" CornerRadius="8" Style="{StaticResource SkeletonBar}" />

                    <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Height="10" Margin="{Binding}" Style="{StaticResource SkeletonBar}" />

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.42*" />
                                <ColumnDefinition Width="0.58*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="8" Style="{StaticResource SkeletonBar}" Opacity="0.7" />
                        </Grid>
                    </Grid>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
