<UserControl x:Class="WinTools.App.Views.Sections.ListSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 行容器：无选中高亮，仅悬停反馈 -->
        <Style x:Key="PlainRowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 通用行：勾选 | 图标 | 标题+说明 | 徽标 | 详情 | 操作按钮 | 开关 -->
        <DataTemplate x:Key="RowTemplate">
            <Grid MinHeight="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Style="{StaticResource AppCheckBox}" Margin="0,0,10,0"
                          VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                          Visibility="{Binding ShowCheckbox, Converter={StaticResource BoolToVisibility}}" />

                <!-- 程序图标：加载到真实图标前显示彩色首字母方块，避免列表跳动 -->
                <Grid Grid.Column="1" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                      Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVisibility}}">
                    <Border CornerRadius="8" Background="{Binding TileBackground}"
                            Visibility="{Binding ShowInitial, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{Binding TileForeground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource App.Text.Primary}" ToolTip="{Binding Title}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource App.Text.Tertiary}"
                               ToolTip="{Binding Subtitle}"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <Border Grid.Column="3" CornerRadius="8" Padding="8,2" Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Background="{Binding BadgeBackground}"
                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{Binding BadgeForeground}" />
                </Border>

                <TextBlock Grid.Column="4" Text="{Binding Detail}" FontSize="12" Margin="12,0,4,0"
                           VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource App.Text.Secondary}" ToolTip="{Binding Detail}" />

                <ComboBox Grid.Column="5" Width="104" Height="26" Margin="8,0,0,0" Padding="8,0"
                          VerticalContentAlignment="Center" FontSize="11.5"
                          ItemsSource="{Binding PickerItems}"
                          SelectedItem="{Binding SelectedPicker, Mode=TwoWay}"
                          Visibility="{Binding ShowPicker, Converter={StaticResource BoolToVisibility}}"
                          Background="{DynamicResource App.SurfaceAlt}"
                          Foreground="{DynamicResource App.Text.Primary}"
                          BorderBrush="{DynamicResource App.Border}" />

                <Button Grid.Column="6" Content="{Binding ActionLabel}" Style="{StaticResource GhostButton}"
                        Padding="12,5" Margin="8,0,0,0" VerticalAlignment="Center"
                        IsEnabled="{Binding IsActionEnabled}"
                        Command="{Binding ActionCommand}"
                        Visibility="{Binding ShowAction, Converter={StaticResource BoolToVisibility}}" />

                <CheckBox Grid.Column="7" Style="{StaticResource AppSwitch}" Margin="14,0,2,0"
                          VerticalAlignment="Center" IsChecked="{Binding IsOn, Mode=TwoWay}"
                          IsEnabled="{Binding IsToggleEnabled}"
                          Visibility="{Binding ShowToggle, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 可选输入行（目录、路径、排除项等） -->
        <Grid Grid.Row="0" Margin="0,0,0,12"
              Visibility="{Binding HasInput, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding InputLabel}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />

            <TextBox Grid.Column="1" Height="32" Padding="10,6" VerticalContentAlignment="Center"
                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="{Binding IsInputMultiline}"
                     Background="{DynamicResource App.SurfaceAlt}"
                     Foreground="{DynamicResource App.Text.Primary}"
                     BorderBrush="{DynamicResource App.Border}"
                     CaretBrush="{DynamicResource App.Text.Primary}" />

            <Button Grid.Column="2" Content="{Binding InputActionLabel}" Style="{StaticResource GhostButton}"
                    Command="{Binding InputCommand}" Padding="14,6" Margin="8,0,0,0" />
        </Grid>

        <!-- 列表 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ListBox ItemsSource="{Binding RowsView}" ItemTemplate="{StaticResource RowTemplate}"
                     ItemContainerStyle="{StaticResource PlainRowItem}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" />
        </Border>
    </Grid>
</UserControl>
