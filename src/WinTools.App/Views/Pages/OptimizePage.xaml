<UserControl x:Class="WinTools.App.Views.Pages.OptimizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="800" d:DesignWidth="1000"
             mc:Ignorable="d">

    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitle}" />

        <!-- 单行工具栏 -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Width="240" Height="32" Padding="10,6"
                     VerticalContentAlignment="Center" ToolTip="{Binding SearchHint}"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource App.SurfaceAlt}"
                     Foreground="{DynamicResource App.Text.Primary}"
                     BorderBrush="{DynamicResource App.Border}"
                     CaretBrush="{DynamicResource App.Text.Primary}" />

            <TextBlock Grid.Column="1" Text="{Binding PendingText}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource App.Accent}" />

            <Button Grid.Column="3" Content="{Binding RecommendedLabel}" Style="{StaticResource GhostButton}"
                    Command="{Binding SelectRecommendedCommand}" Padding="14,7" Margin="0,0,8,0" />

            <Button Grid.Column="4" Content="{Binding SelectAllLabel}" Style="{StaticResource GhostButton}"
                    Command="{Binding SelectAllCommand}" Padding="14,7" Margin="0,0,8,0" />

            <Button Grid.Column="5" Content="{Binding ApplyLabel}" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ApplyCommand}" Padding="18,7" Margin="0,0,8,0"
                    IsEnabled="{Binding HasPending}" />

            <Button Grid.Column="6" Content="{Binding RevertLabel}" Style="{StaticResource GhostButton}"
                    Command="{Binding RevertCommand}" Padding="14,7" Margin="0,0,8,0" />

            <Button Grid.Column="7" Content="{Binding RefreshLabel}" Style="{StaticResource SubtleButton}"
                    Command="{Binding RefreshCommand}" Padding="12,7" />
        </Grid>

        <!-- 分类 + 条目 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="8">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <!-- 分类头 -->
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" HorizontalContentAlignment="Left" Padding="8,0"
                                                Command="{Binding DataContext.ToggleGroupCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource App.Text.Tertiary}"
                                                      StrokeThickness="1.4" VerticalAlignment="Center" Margin="2,0,8,0"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="0" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="90" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>

                                                <TextBlock Text="{Binding Glyph}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource App.Text.Secondary}"
                                                           Margin="0,0,8,0" />

                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource App.Text.Primary}" />

                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="1" Content="{Binding DataContext.SelectAllLabel,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Style="{StaticResource SubtleButton}" FontSize="11.5"
                                                Padding="10,2" Margin="0,0,6,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ToggleGroupAllCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <!-- 条目 -->
                                    <ItemsControl ItemsSource="{Binding Items}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="30,0,10,0" MinHeight="40">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" Style="{StaticResource AppCheckBox}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,5">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource App.Text.Primary}" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}"
                                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Style="{StaticResource SafetyBadge}"
                                                            Margin="8,0,0,0" VerticalAlignment="Center"
                                                            Tag="{Binding RiskKey}" />

                                                    <Border Grid.Column="3" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource App.Success}"
                                                            Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding DataContext.AppliedLabel,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource App.OnSafety}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,8" />

                <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource App.Text.Tertiary}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
