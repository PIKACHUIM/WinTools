<UserControl x:Class="WinTools.App.Controls.ResultSummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext 是 ResultSummary。 -->
    <Border Style="{StaticResource Card}" Padding="16,12" CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center"
                    Background="{Binding AccentBrush}" Opacity="0.95">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="17" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <ItemsControl Grid.Column="2" ItemsSource="{Binding Metrics}" VerticalAlignment="Center" Margin="12,0,8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="14,0,0,0" MinWidth="58">
                            <TextBlock Text="{Binding Value}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.Text.Primary}" />
                            <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" Margin="0,1,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}"
                        Style="{StaticResource GhostButton}" Padding="14,6"
                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="DismissButton" Content="&#xE711;" Style="{StaticResource SubtleButton}"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Padding="9,7"
                        Margin="6,0,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
