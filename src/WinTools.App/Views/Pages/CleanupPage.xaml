<UserControl x:Class="WinTools.App.Views.Pages.CleanupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinTools.App.ViewModels"
             xmlns:ctl="clr-namespace:WinTools.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="800" d:DesignWidth="1000"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="GroupHeaderButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <Style x:Key="RingValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        </Style>

        <Style x:Key="RingLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="ResultValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题 + 已扫描时的合计 -->
            <Grid Grid.Row="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding IsReadyPhase, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding TotalLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource ValueText}" Margin="6,0,18,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedText}" Style="{StaticResource ValueText}" Margin="6,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource App.Accent}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,0">

                <!-- ============ 1. 待扫描：磁盘环形图 + 分区 + 扫描 ============ -->
                <Grid Visibility="{Binding IsIdlePhase, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="16,14" VerticalAlignment="Top">
                        <Grid Width="264" Height="220">
                                <ctl:DonutChart Slices="{Binding DiskSlices}" Thickness="18" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding DiskCenterValue}" Style="{StaticResource RingValue}" />
                                    <TextBlock Text="{Binding DiskCenterLabel}" Style="{StaticResource RingLabel}" />
                                </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <Border Style="{StaticResource Card}" Padding="18,14">
                            <StackPanel>
                                <TextBlock Text="{Binding DiskUsageLabel}" Style="{StaticResource CaptionText}"
                                           Margin="0,0,0,10" />

                                <ItemsControl ItemsSource="{Binding Volumes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Style="{StaticResource BodyText}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                                    <Run Text="   " />
                                                    <Run Text="{Binding UsedBytes, Mode=OneWay, Converter={StaticResource BytesToSize}}" />
                                                    <Run Text=" / " />
                                                    <Run Text="{Binding TotalBytes, Mode=OneWay, Converter={StaticResource BytesToSize}}" />
                                                </TextBlock>

                                                <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource App.Accent}"
                                                           Text="{Binding UsedPercent, Converter={StaticResource PercentText}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="{Binding ScanLabel}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ScanCommand}" Padding="40,11" FontSize="14" />
                        </StackPanel>

                        <TextBlock Text="{Binding ScanIdleHint}" Style="{StaticResource CaptionText}"
                                   Margin="2,12,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                                   Margin="2,6,0,0" Foreground="{DynamicResource App.Danger}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding StatusText, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </Grid>

                <!-- ============ 2. 扫描中 ============ -->
                <Border Style="{StaticResource Card}" Padding="20"
                        Visibility="{Binding IsScanningPhase, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20,0,20">
                        <Grid Width="200" Height="200" HorizontalAlignment="Center">
                            <ctl:DonutChart Slices="{Binding ScanSlices}" Thickness="15" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding ProgressPercent, Converter={StaticResource PercentText}}"
                                           Style="{StaticResource RingValue}" />
                                <TextBlock Text="{Binding ScanFoundText}" Style="{StaticResource RingLabel}"
                                           Foreground="{DynamicResource App.Accent}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding ScanningTitle}" Style="{StaticResource BodyText}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" MaxWidth="420"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- ============ 3. 已扫描：双环图 + 分类列表 ============ -->
                <Grid Visibility="{Binding IsReadyPhase, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="264" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Padding="14,12" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Width="232" Height="200" HorizontalAlignment="Center">
                                <ctl:DonutChart Slices="{Binding OuterRing}" Thickness="10" /><ctl:DonutChart Slices="{Binding InnerRing}" Thickness="10" Margin="24" />
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding ResultCenterValue}" Style="{StaticResource RingValue}"
                                               FontSize="21" />
                                    <TextBlock Text="{Binding ResultCenterLabel}" Style="{StaticResource RingLabel}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{DynamicResource App.Success}" />
                                <TextBlock Text="{Binding SelectedOfTotal}" Style="{StaticResource CaptionText}"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Content="{Binding CleanLabel}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CleanCommand}" Margin="0,14,0,0" Padding="16,10" />
                            <Button Content="{Binding SelectAllLabel}" Style="{StaticResource GhostButton}"
                                    Command="{Binding SelectAllCommand}" Margin="0,8,0,0" Padding="14,8" />
                            <Button Content="{Binding RescanLabel}" Style="{StaticResource SubtleButton}"
                                    Command="{Binding ScanCommand}" Margin="0,6,0,0" Padding="12,7" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="16,0,0,0" Padding="10,8">
                        <Grid MinHeight="420">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <Button Command="{Binding DataContext.ToggleExpandedCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        HorizontalContentAlignment="Stretch" Padding="6,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="13" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource App.Text.Secondary}"
                                                                   Margin="0,0,8,0" />

                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource App.Text.Primary}" />

                                                        <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   Margin="10,0,0,0" VerticalAlignment="Center" />

                                                        <Button Grid.Column="3"
                                                                Content="{Binding DataContext.SelectAllLabel,
                                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Style="{StaticResource GroupHeaderButton}"
                                                                Command="{Binding DataContext.ToggleGroupCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Button>

                                                <ItemsControl ItemsSource="{Binding Items}"
                                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="30,0,8,0" Height="34">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0" Style="{StaticResource AppCheckBox}"
                                                                          VerticalAlignment="Center" Margin="0,0,10,0"
                                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                          IsEnabled="{Binding IsCleanable}" />

                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Foreground="{DynamicResource App.Text.Primary}" />
                                                                    <TextBlock Text="{Binding FileText}"
                                                                               Style="{StaticResource CaptionText}"
                                                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>

                                                                <Border Grid.Column="2" Style="{StaticResource SafetyBadge}"
                                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                                        Tag="{Binding SafetyKey}">
                                                                    <TextBlock Text="{Binding SafetyText}" FontSize="10.5" />
                                                                </Border>

                                                                <TextBlock Grid.Column="3" Text="{Binding SizeText}"
                                                                           Style="{StaticResource CaptionText}"
                                                                           VerticalAlignment="Center" Width="76"
                                                                           TextAlignment="Right" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource BodyText}"
                                       Foreground="{DynamicResource App.Text.Tertiary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ 4. 清理中 ============ -->
                <Border Style="{StaticResource Card}" Padding="20"
                        Visibility="{Binding IsCleaningPhase, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,20,0,20">
                        <Grid Width="200" Height="200" HorizontalAlignment="Center">
                            <ctl:DonutChart Slices="{Binding ScanSlices}" Thickness="15" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding ProgressPercent, Converter={StaticResource PercentText}}"
                                           Style="{StaticResource RingValue}" />
                                <TextBlock Text="{Binding ScanFoundText}" Style="{StaticResource RingLabel}"
                                           Foreground="{DynamicResource App.Success}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding CleaningTitle}" Style="{StaticResource BodyText}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" MaxWidth="420"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- ============ 5. 完成：结果总结 ============ -->
                <Border Style="{StaticResource Card}" Padding="24"
                        Visibility="{Binding IsDonePhase, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="620">
                        <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                                Background="{DynamicResource App.Success}">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="30" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="{Binding DoneTitle}" Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <StackPanel Margin="22,0">
                                <TextBlock Text="{Binding ResultFreedText}" Style="{StaticResource ResultValue}"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource App.Success}" />
                                <TextBlock Text="{Binding FreedLabel}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Margin="22,0">
                                <TextBlock Text="{Binding ResultFilesText}" Style="{StaticResource ResultValue}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding FilesLabel}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Margin="22,0">
                                <TextBlock Text="{Binding ResultSkippedText}" Style="{StaticResource ResultValue}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SkippedLabel}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Margin="22,0">
                                <TextBlock Text="{Binding ResultElapsedText}" Style="{StaticResource ResultValue}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ElapsedLabel}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding ResultRemainingText}" Style="{StaticResource CaptionText}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"
                                   Visibility="{Binding ResultRemainingText, Converter={StaticResource StringToVisibility}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="{Binding ContinueLabel}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ContinueCommand}" Padding="22,9"
                                    Visibility="{Binding HasRemaining, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="{Binding FinishLabel}" Style="{StaticResource GhostButton}"
                                    Command="{Binding FinishCommand}" Padding="22,9" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
