<UserControl x:Class="WinTools.App.Controls.Spinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="16" Height="16" IsHitTestVisible="False">

    <!-- 旋转弧线：只在可见时转动，隐藏即停止，不占 CPU -->
    <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
             StrokeThickness="2" StrokeDashArray="5 3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
             RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
            <RotateTransform Angle="0" />
        </Ellipse.RenderTransform>
        <Ellipse.Style>
            <Style TargetType="Ellipse">
                <Style.Triggers>
                    <Trigger Property="IsVisible" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard x:Name="Spin">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="Spin" />
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Ellipse.Style>
    </Ellipse>
</UserControl>
