<UserControl x:Class="WinTools.App.Views.Sections.EditionSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <!-- 当前渠道信息 -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding EditionLabel}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding CurrentEdition}" FontSize="19" FontWeight="SemiBold"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource App.Text.Primary}" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding CurrentVersion}" Style="{StaticResource BodyText}"
                                       Margin="6,0,18,0" />
                            <TextBlock Text="{Binding BuildLabel}" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding CurrentBuild}" Style="{StaticResource BodyText}"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Top"
                            Background="{DynamicResource App.SurfaceAlt}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="7" Height="7" CornerRadius="3.5" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource App.Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActivated}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource App.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding ActivationText}" FontSize="11.5" Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.Text.Secondary}" />
                            <TextBlock Text="{Binding PartialKey}" FontSize="11" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.Text.Tertiary}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 目标渠道 -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding PreferEditionLabel}" Style="{StaticResource CaptionText}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Height="36" VerticalContentAlignment="Center" Padding="10,0"
                                  ItemsSource="{Binding Editions}"
                                  SelectedItem="{Binding SelectedEdition, Mode=TwoWay}"
                                  Background="{DynamicResource App.SurfaceAlt}"
                                  Foreground="{DynamicResource App.Text.Primary}"
                                  BorderBrush="{DynamicResource App.Border}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id, Converter={StaticResource EditionName}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1" Content="{Binding PrimaryLabel}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding PrimaryCommand}" IsEnabled="{Binding CanPrimary}"
                                Padding="22,9" Margin="10,0,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{Binding ProductKeyLabel}" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding SelectedKey}" Style="{StaticResource CaptionText}"
                                   Margin="8,0,0,0" Foreground="{DynamicResource App.Text.Secondary}" />
                    </StackPanel>

                    <Border Margin="0,12,0,0" CornerRadius="8" Padding="12,9"
                            Background="{DynamicResource App.SurfaceAlt}">
                        <TextBlock Text="{Binding NoActivationHint}" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{DynamicResource App.Text.Secondary}" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
