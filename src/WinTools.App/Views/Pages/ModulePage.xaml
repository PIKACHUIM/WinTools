<UserControl x:Class="WinTools.App.Views.Pages.ModulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:WinTools.App.Views.Sections"
             xmlns:ctl="clr-namespace:WinTools.App.Controls"
             xmlns:vm="clr-namespace:WinTools.App.ViewModels.Modules">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ListSectionViewModel}">
            <sections:ListSectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupTaskViewModel}">
            <sections:BackupTaskView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemFeaturesSectionViewModel}">
            <sections:FeaturesSectionView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitle}" />

        <!-- 页签 + 工具栏：同一行 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource PillItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VerticalAlignment="Center"
                     Visibility="{Binding HasSections, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 公共工具栏：搜索框吃掉剩余宽度，按钮固定；页签内容不使用公共工具栏时整块隐藏 -->
            <Grid Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" DataContext="{Binding Toolbar}"
                  Visibility="{Binding DataContext.HasToolbar,
                               RelativeSource={RelativeSource AncestorType=UserControl},
                               Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Style="{StaticResource SearchBox}" MinWidth="150" MaxWidth="240"
                         HorizontalAlignment="Right"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding SearchHint}"
                         Visibility="{Binding HasSearch, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="24"
                           Visibility="{Binding CountText, Converter={StaticResource StringToVisibility}}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="{Binding ToggleAllText}" Style="{StaticResource SubtleButton}"
                            Command="{Binding ToggleAllCommand}" Padding="8,6" Margin="0,0,4,0"
                            Visibility="{Binding ShowCheckboxes, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="{Binding SecondaryLabel}" Style="{StaticResource GhostButton}"
                            Command="{Binding SecondaryCommand}" Padding="11,6" Margin="0,0,6,0"
                            Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibility}}" />

                    <Button Content="{Binding PrimaryLabel}" Style="{StaticResource PrimaryButton}"
                            Command="{Binding PrimaryCommand}" IsEnabled="{Binding CanPrimary}"
                            Padding="13,6" Margin="0,0,6,0"
                            Visibility="{Binding HasPrimary, Converter={StaticResource BoolToVisibility}}" />

                    <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}"
                            Padding="10,6" ToolTip="{Binding RefreshLabel}"
                            Visibility="{Binding HasRefresh, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ctl:Spinner Width="13" Height="13" Margin="0,0,7,0"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding RefreshLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 长任务进度 + 操作结果摘要 -->
        <StackPanel Grid.Row="2" DataContext="{Binding Toolbar}"
                    Visibility="{Binding DataContext.HasToolbar,
                                 RelativeSource={RelativeSource AncestorType=UserControl},
                                 Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Style="{StaticResource AppProgress}" Height="4" Margin="0,10,0,0"
                         Maximum="100" Value="{Binding ProgressPercent}"
                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

            <ctl:ResultSummaryCard Margin="0,12,0,0" DataContext="{Binding Result}"
                                   DismissCommand="{Binding DataContext.DismissResultCommand,
                                                    RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                   Visibility="{Binding Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>

        <!-- 内容 + 状态浮层 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <ContentControl Content="{Binding SelectedSection.Content}" />

            <Border Style="{StaticResource Card}" Padding="8" DataContext="{Binding Toolbar}"
                    Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}}">
                <ctl:PageStateOverlay />
            </Border>
        </Grid>
    </Grid>
</UserControl>
