<Application x:Class="WinTools.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局字体：Maple Mono NL NF CN（内置，缺字回退到系统中文与西文字体） -->
            <FontFamily x:Key="App.FontFamily">pack://application:,,,/Assets/Fonts/#Maple Mono NL NF CN, Microsoft YaHei UI, Segoe UI</FontFamily>

            <!-- 图标字体单独保留，避免被全局字体覆盖 -->
            <FontFamily x:Key="App.IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
