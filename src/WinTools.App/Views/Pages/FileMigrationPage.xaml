<UserControl x:Class="WinTools.App.Views.Pages.FileMigrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="900" d:DesignWidth="1000"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="TargetBox" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="CaretBrush" Value="{DynamicResource App.Text.Primary}" />
        </Style>

        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <!-- 深色主题下 ComboBox 默认模板是白底，这里统一用胶囊选项 -->
        <Style x:Key="OptionPill" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource App.Text.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="9,4"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent.Soft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,24">

            <!-- 标题 -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                               Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="760" />
                </StackPanel>

                <Button Content="{Binding RefreshLabel}" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Padding="14,7" Command="{Binding ScanCommand}" />
            </Grid>

            <!-- 目标分区 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding TargetVolumeLabel}"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <ListBox Grid.Column="1" ItemsSource="{Binding Volumes}"
                             SelectedItem="{Binding SelectedVolume, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource OptionPill}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             VerticalAlignment="Center"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding Label}" Margin="6,0,0,0" FontSize="12" />
                                    <TextBlock Text="{Binding FreeBytes, Converter={StaticResource BytesToSize}}"
                                               Margin="8,0,0,0" FontSize="11" Opacity="0.75" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Column="2" Text="{Binding VolumeHint}" Style="{StaticResource CaptionText}"
                               Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 迁移列表 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="{Binding AppHint}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" Margin="2,0,0,6" />

                    <TextBlock Text="{Binding ScanningText}" Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource App.Text.Tertiary}" Margin="2,6,0,6"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Rows}"
                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="2,6,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" Style="{StaticResource AppCheckBox}"
                                                  VerticalAlignment="Top" Margin="0,4,10,0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource App.Text.Primary}" />
                                                <TextBlock Text="{Binding KindText}" Style="{StaticResource CaptionText}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FileText}" Style="{StaticResource CaptionText}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding CurrentPath}" FontSize="11"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CurrentPath}"
                                                       Foreground="{DynamicResource App.Text.Tertiary}" />

                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="→" FontSize="12" Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource App.Text.Tertiary}" />

                                                <TextBox Grid.Column="1" Style="{StaticResource TargetBox}"
                                                         Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>

                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                                   Width="84" TextAlignment="Right" VerticalAlignment="Top"
                                                   Margin="10,4,0,0" />

                                        <ListBox Grid.Column="3" Width="170" Margin="12,2,0,0"
                                                 VerticalAlignment="Top"
                                                 ItemsSource="{Binding DataContext.Actions,
                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 SelectedIndex="{Binding ActionIndex, Mode=TwoWay}"
                                                 ItemContainerStyle="{StaticResource OptionPill}"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                        </ListBox>
                                    </Grid>

                                    <Border Style="{StaticResource RowSeparator}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource App.Text.Tertiary}" Margin="2,12,0,12"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 操作与进度 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,14">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding SelectAllLabel}" Style="{StaticResource GhostButton}"
                                    Padding="12,6" Command="{Binding SelectAllCommand}" />
                            <Button Content="{Binding ClearSelectionLabel}" Style="{StaticResource GhostButton}"
                                    Padding="12,6" Margin="8,0,0,0" Command="{Binding ClearSelectionCommand}" />
                            <Button Content="{Binding RestoreDefaultLabel}" Style="{StaticResource GhostButton}"
                                    Padding="12,6" Margin="8,0,0,0" Command="{Binding RestoreDefaultCommand}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button Content="{Binding StartLabel}" Style="{StaticResource PrimaryButton}"
                                    Padding="20,8" Command="{Binding MigrateCommand}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Style="{StaticResource AppProgress}" Height="4" Maximum="100"
                                 Value="{Binding ProgressPercent}" Margin="0,12,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                               Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
